# Example environment file for Remote Proxy Docker Compose
# Copy this to .env in the project root and fill in your values
#
# cp docker/remote-proxy.env.example .env

# =============================================================================
# LLM API Keys
# Both central server and remote proxies need these to make LLM calls
# =============================================================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Azure OpenAI (optional)
# AZURE_API_KEY=your-azure-key
# AZURE_API_BASE=https://your-resource.openai.azure.com

# =============================================================================
# Central Server Settings
# =============================================================================

# Master key for admin access to central server
LITELLM_MASTER_KEY=sk-master-key-change-this-in-production

# Internal service key for remote proxy authentication
# Remote proxies use this to authenticate with central server's internal APIs
LITELLM_INTERNAL_SERVICE_KEY=sk-internal-service-key-change-this-in-production

# =============================================================================
# Remote Proxy Settings  
# These are set in docker-compose.yml but can be overridden here
# =============================================================================

# REMOTE_PROXY_ENABLED=true
# CENTRAL_SERVER_URL=http://central:4000
# CENTRAL_SERVICE_KEY=sk-internal-service-key-change-this-in-production
